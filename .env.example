# Quran Audio-to-Ayah Indexer Configuration
# Copy this to .env and fill in your values

# =============================================================================
# AUDIO SOURCE CONFIGURATION
# =============================================================================
# Pattern for downloading surah audio. Placeholders: {surah:03d}, {reciter}
# Example sources:
#   - https://server8.mp3quran.net/{reciter}/{surah:03d}.mp3
#   - https://download.quranicaudio.com/quran/{reciter}/{surah:03d}.mp3
AUDIO_SOURCE_PATTERN=https://server8.mp3quran.net/{reciter}/{surah:03d}.mp3

# Default reciter folder name (varies by source)
DEFAULT_RECITER=mishary_alafasy

# =============================================================================
# TEXT CORPUS SOURCE
# =============================================================================
# Options: "tanzil" or "qurancom"
CORPUS_SOURCE=qurancom

# Quran.com API base URL
QURAN_API_BASE=https://api.quran.com/api/v4

# =============================================================================
# ALIGNMENT CONFIGURATION
# =============================================================================
# Whisper model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v2

# Device: cuda, cpu, or auto
COMPUTE_DEVICE=auto

# Confidence threshold below which ayahs are flagged for review
CONFIDENCE_THRESHOLD=0.85

# =============================================================================
# AZURE AI SEARCH (OPTIONAL)
# =============================================================================
# Leave blank to skip Azure upload
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=quran-ayah-index

# =============================================================================
# VALIDATION
# =============================================================================
# EveryAyah.com pattern for ground-truth per-ayah clips
# Pattern: {reciter}/{surah:03d}{ayah:03d}.mp3
EVERYAYAH_PATTERN=https://everyayah.com/data/{reciter}/{surah:03d}{ayah:03d}.mp3

# Target boundary error in milliseconds
TARGET_BOUNDARY_ERROR_MS=300

# =============================================================================
# PATHS
# =============================================================================
DATA_DIR=./data
AUDIO_DIR=./data/audio
CORPUS_DIR=./data/corpus
OUTPUT_DIR=./data/output
